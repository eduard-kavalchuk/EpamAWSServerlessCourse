{
  "version": "1.0",
  "name": "api_handler",
  "func_name": "handler.lambda_handler",
  "resource_type": "lambda",
  "iam_role_name": "api_handler-role",
  "runtime": "python3.10",
  "memory": 128,
  "timeout": 100,
  "lambda_path": "lambdas/api_handler",
  "dependencies": [],
  "event_sources": [],
  "env_variables": {
    "DB_HOST": {
      "resource_name": "logistic-cluster",
      "resource_type": "rds_db_cluster",
      "parameter": "endpoint"
    },
    "DB_SECRET_NAME": {
      "resource_name": "logistic-cluster",
      "resource_type": "rds_db_cluster",
      "parameter": "master_user_secret_name"
    },
    "DB_NAME": "logisticdb"
  },
  "publish_version": true,
  "alias": "${lambdas_alias_name}",
  "url_config": {},
  "ephemeral_storage": 512,
  "logs_expiration": "${logs_expiration}",
  "subnet_ids": [
    "${lambda_sn_id}"
  ],
  "security_group_ids": [
    "${logistic_sg_id}"
  ],
  "tags": {}
}